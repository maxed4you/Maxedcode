{
  "name": "maxedcode",
  "version": "1.0.2",
  "description": "A coding agent that runs on your own models: local (LM Studio, Ollama, llama.cpp, vLLM) or any OpenAI-compatible API. Windows, Linux and macOS. CLI + app window + browser extension.",
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "llm",
    "local-llm",
    "ollama",
    "lm-studio",
    "llama.cpp",
    "openai",
    "windows",
    "linux",
    "macos",
    "terminal"
  ],
  "homepage": "https://github.com/maxed4you/Maxedcode#readme",
  "bugs": "https://github.com/maxed4you/Maxedcode/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxed4you/Maxedcode.git"
  },
  "license": "Apache-2.0",
  "author": "maxed4you",
  "bin": {
    "maxedcode": "bin/maxedcode.js"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "agent/",
    "!agent/tests/",
    "!agent/run_all_tests.*",
    "!agent/settings.json",
    "!agent/config.json",
    "!**/__pycache__/",
    "desktop/",
    "!desktop/README.md",
    "!desktop/app/maxedcode.exe",
    "!desktop/app/maxedcode.new.exe",
    "!desktop/app/python.txt",
    "installer/bootstrap.ps1",
    "installer/bootstrap.sh"
  ]
}
