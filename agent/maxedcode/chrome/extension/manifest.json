{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "maxedcode",
  "version": "1.4.6",
  "description": "__MSG_description__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+E"
      },
      "description": "__MSG_openPanel__"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "sidePanel",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
